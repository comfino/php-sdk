<?xml version="1.0"?>
<ruleset name="ComfinoPay PHP SDK">
    <description>PSR-12 coding standard.</description>

    <file>src</file>
    <file>tests</file>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <!-- PSR-12's 120-column limit is a soft guideline (SHOULD NOT); this project raises it to 160 and doesn't let a line-length
         warning alone fail the build the way a real error would. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="PSR12"/>

    <!-- Keep 160 as the soft/warning target, but give marginal overflow (a long identifier or a docblock line a few characters
         over) room before it becomes a hard error. -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="160"/>
            <property name="absoluteLineLimit" value="180"/>
        </properties>
    </rule>
</ruleset>